# Copy to .env and adjust. Every value is optional.

PORT=4000
CORS_ORIGIN=http://localhost:5173

# Signs session tokens. Change this in production.
SESSION_SECRET=change-me

# Guards the activation-code admin endpoints (future admin app).
ADMIN_KEY=sompo-admin

# Leave DB_HOST empty to use the built-in JSON store at backend/data/store.json.
# Set it to switch to MySQL (import database/schema.sql first).
DB_HOST=
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sompo_team

# ── Audius music catalog ──────────────────────────────────────────────
# Reads are public, so the app works without these. The key is sent as
# X-API-KEY for rate-limit attribution; the secret and bearer are only
# needed if you later add write operations through the Audius SDK.
AUDIUS_APP_NAME=SOMPO TEAM
AUDIUS_API_KEY=
AUDIUS_API_SECRET=
AUDIUS_BEARER_TOKEN=

# proxy  -> audio is piped through this server so it carries our CORS headers.
#           Required for the visualiser; costs bandwidth.
# direct -> hand the browser the Audius node URL. Cheaper, but some Audius
#           redirects end on storage without CORS and the analyser goes silent.
AUDIUS_STREAM_MODE=proxy

# Absolute origin of THIS api when it is not on the same host as the frontend.
# Leave empty and the frontend resolves stream paths against its own API base.
PUBLIC_API_URL=
